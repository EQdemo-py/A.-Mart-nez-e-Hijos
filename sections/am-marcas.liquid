{%- style -%}
  #AMMarcas-{{ section.id }} {
    --am-columns-desktop: {{ section.settings.columns_desktop }};
    --am-columns-mobile: {{ section.settings.columns_mobile }};
    --am-logo-height: {{ section.settings.logo_height }}px;
    --am-gap: {{ section.settings.gap }}px;

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #AMMarcas-{{ section.id }} .am-marcas__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  #AMMarcas-{{ section.id }} .am-marcas__heading {
    margin: 0 0 28px;
    text-align: {{ section.settings.heading_alignment }};
  }

  #AMMarcas-{{ section.id }} .am-marcas__heading h2 {
    margin: 0;
  }

  #AMMarcas-{{ section.id }} .am-marcas__grid {
    display: grid;
    grid-template-columns: repeat(var(--am-columns-desktop), minmax(0, 1fr));
    gap: var(--am-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #AMMarcas-{{ section.id }} .am-marcas__item {
    min-width: 0;
  }

  #AMMarcas-{{ section.id }} .am-marcas__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: var(--am-logo-height);
    text-decoration: none;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  #AMMarcas-{{ section.id }} .am-marcas__image {
    display: block;
    width: 100%;
    height: var(--am-logo-height);
    object-fit: contain;
    object-position: center;
  }

  #AMMarcas-{{ section.id }} .am-marcas__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: var(--am-logo-height);
    font-size: 1.4rem;
    text-align: center;
    opacity: .55;
  }

  @media screen and (max-width: 749px) {
    #AMMarcas-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #AMMarcas-{{ section.id }} .am-marcas__inner {
      padding-left: 16px;
      padding-right: 16px;
    }

    #AMMarcas-{{ section.id }} .am-marcas__heading {
      margin-bottom: 20px;
    }

    #AMMarcas-{{ section.id }} .am-marcas__grid {
      grid-template-columns: repeat(var(--am-columns-mobile), minmax(0, 1fr));
      gap: {{ section.settings.gap_mobile }}px;
    }

    #AMMarcas-{{ section.id }} .am-marcas__link,
    #AMMarcas-{{ section.id }} .am-marcas__placeholder {
      min-height: {{ section.settings.logo_height_mobile }}px;
    }

    #AMMarcas-{{ section.id }} .am-marcas__image {
      height: {{ section.settings.logo_height_mobile }}px;
    }

    {% if section.settings.mobile_carousel %}
      #AMMarcas-{{ section.id }} .am-marcas__grid {
        display: flex;
        overflow-x: auto;
        grid-template-columns: none;
        gap: {{ section.settings.gap_mobile }}px;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        scrollbar-width: none;
        padding-bottom: 4px;
      }

      #AMMarcas-{{ section.id }} .am-marcas__grid::-webkit-scrollbar {
        display: none;
      }

      #AMMarcas-{{ section.id }} .am-marcas__item {
        flex: 0 0 calc(
          (100% - ({{ section.settings.columns_mobile | minus: 1 }} * {{ section.settings.gap_mobile }}px))
          / {{ section.settings.columns_mobile }}
        );
        scroll-snap-align: start;
      }
    {% endif %}
  }
{%- endstyle -%}

<section
  id="AMMarcas-{{ section.id }}"
  class="am-marcas color-{{ section.settings.color_scheme }} gradient"
>
  <div class="am-marcas__inner">
    {%- if section.settings.title != blank -%}
      <div class="am-marcas__heading">
        <h2 class="{{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}

    <ul class="am-marcas__grid" role="list">
      {%- for block in section.blocks -%}
        <li
          class="am-marcas__item"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.link != blank -%}
            <a
              class="am-marcas__link"
              href="{{ block.settings.link }}"
              aria-label="{{ block.settings.name | default: 'Ver marca' | escape }}"
            >
          {%- else -%}
            <div class="am-marcas__link">
          {%- endif -%}

          {%- if block.settings.logo != blank -%}
            {{
              block.settings.logo
              | image_url: width: 600
              | image_tag:
                loading: 'lazy',
                widths: '120, 180, 240, 320, 480, 600',
                class: 'am-marcas__image',
                alt: block.settings.name
            }}
          {%- else -%}
            <span class="am-marcas__placeholder">
              {{ block.settings.name | default: 'Agregar logo' }}
            </span>
          {%- endif -%}

          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "A. Martínez — Marcas",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Nuestras marcas"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alineación del título",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Escritorio"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Marcas por fila",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Altura de los logos",
      "min": 60,
      "max": 180,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Separación",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Móvil"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Marcas visibles",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "mobile_carousel",
      "label": "Activar carrusel horizontal",
      "default": true
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Altura de los logos",
      "min": 50,
      "max": 140,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Separación",
      "min": 4,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Superior escritorio",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Inferior escritorio",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Superior móvil",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Inferior móvil",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marca",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nombre de la marca"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "A. Martínez — Marcas",
      "blocks": [
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ]
}
{% endschema %}
