{{ 'amartinez-home.css' | asset_url | stylesheet_tag }}

<section class="am-home">
  <div class="am-hero">
    <div class="am-hero__inner page-width">
      <div class="am-hero__content">
        <span class="am-hero__eyebrow">A. MARTÍNEZ E HIJOS</span>

        <h1>
          Todo lo que necesitás,<br>
          <strong>de marcas que conocés.</strong>
        </h1>

        <p>
          Más de 100 años acercando calidad, innovación
          y grandes marcas a las familias paraguayas.
        </p>

        <div class="am-hero__actions">
          <a href="/collections/all" class="am-btn am-btn--primary">
            Comprar ahora
          </a>

          <a href="#marcas" class="am-btn am-btn--secondary">
            Ver marcas
          </a>
        </div>
      </div>

      <div class="am-hero__visual">
        {% if section.settings.hero_image != blank %}
          {{
            section.settings.hero_image
            | image_url: width: 1400
            | image_tag:
              loading: 'eager',
              widths: '550, 750, 1100, 1400',
              class: 'am-hero__image'
          }}
        {% else %}
          <div class="am-hero__placeholder">
            <span>TERMOS</span>
            <span>HOGAR</span>
            <span>COCINA</span>
            <span>ESCOLAR</span>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="am-brands" id="marcas">
    <div class="page-width">
      <p class="am-brands__label">ENCONTRÁ TUS MARCAS FAVORITAS</p>

      <div class="am-brands__grid">
        <span>BIC</span>
        <span>TERMOLAR</span>
        <span>OU</span>
        <span>COLEMAN</span>
        <span>BESTWAY</span>
        <span>IMUSA</span>
        <span>WAHSON</span>
      </div>
    </div>
  </div>

  <div class="am-categories page-width">
    <div class="am-section-heading">
      <div>
        <span>EXPLORÁ</span>
        <h2>Comprá por categoría</h2>
      </div>
      <a href="/collections">Ver todas →</a>
    </div>

    <div class="am-category-grid">
      <a href="/collections/all" class="am-category-card">
        <div class="am-category-card__icon">⌂</div>
        <strong>Hogar</strong>
        <span>Ver productos →</span>
      </a>

      <a href="/collections/all" class="am-category-card">
        <div class="am-category-card__icon">◉</div>
        <strong>Termos y tereré</strong>
        <span>Ver productos →</span>
      </a>

      <a href="/collections/all" class="am-category-card">
        <div class="am-category-card__icon">✎</div>
        <strong>Escolar y oficina</strong>
        <span>Ver productos →</span>
      </a>

      <a href="/collections/all" class="am-category-card">
        <div class="am-category-card__icon">□</div>
        <strong>Organización</strong>
        <span>Ver productos →</span>
      </a>

      <a href="/collections/all" class="am-category-card">
        <div class="am-category-card__icon">☀</div>
        <strong>Piscinas y verano</strong>
        <span>Ver productos →</span>
      </a>

      <a href="/collections/all" class="am-category-card">
        <div class="am-category-card__icon">◇</div>
        <strong>Cocina</strong>
        <span>Ver productos →</span>
      </a>
    </div>
  </div>

  <div class="am-b2b page-width">
    <div>
      <span class="am-b2b__eyebrow">VENTAS MAYORISTAS</span>
      <h2>¿Comprás para tu negocio?</h2>
      <p>
        Accedé a nuestro catálogo y solicitá una cotización
        especial para tu empresa.
      </p>
    </div>

    <a href="/pages/contact" class="am-btn am-btn--light">
      Solicitar presupuesto →
    </a>
  </div>
</section>

{% schema %}
{
  "name": "A. Martinez - Home",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagen principal"
    }
  ],
  "presets": [
    {
      "name": "A. Martinez - Home"
    }
  ]
}
{% endschema %}
